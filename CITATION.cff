    email: "yiyan.ng.ml@gmail.com"
repository-code: "https://github.com/hectopascal/agent-credit-bench"
url: "https://hectopascal.github.io/agent-credit-bench/"
doi: "10.5281/zenodo.22178939"
version: 0.5.0
date-released: 2026-08-30
license: MIT
keywords:
  - agentic reinforcement learning
  - turn-level credit assignment
  - advantage estimation
  - policy gradient
  - GRPO
  - RLOO
  - GAE
  - GiGPO
  - LLM agents
  - benchmark
